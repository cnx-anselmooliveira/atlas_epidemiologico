# Atlas Epidemiológico — variáveis do projeto (um único exemplo).
#
# LOCAL: copie para .env na raiz (ignorado pelo Git) e troque só as senhas marcadas.
#        ./platform/dev.ps1 up e npm run dev (frontend/) leem este arquivo.
# PORTAINER (hml e prod): no stack, use "Load variables from .env file" com este arquivo e
#        preencha os valores; senhas e tokens reais ficam SÓ lá (nunca no Git, nunca em imagem).
#
# Legenda: [obrigatória] sem padrão; [padrão] pode ficar assim; [segredo] valor real só no .env
# local e nas variáveis do stack. Chaves de service account NÃO entram aqui: em dev ficam em
# platform/secrets/ e em hml/prod são Docker secrets (deploy/README.md).
# Os valores abaixo são só de exemplo.

# ======================================================================================
# 1. Comum aos ambientes
# ======================================================================================

# [obrigatória] Ambiente: dev (local), hml ou prod. Define onde cada ambiente lê e escreve:
# no bucket, mlflow/<ambiente>, cosmos_cache/<ambiente>, dbt_docs/<ambiente> e o landing do SINAN
# (landing/<ambiente>/sinan/dengue/; em dev, landing/sinan/dengue/); no BigQuery, bronze, silver,
# gold e forecast em dev e <camada>_hml / <camada>_prod em hml e prod. Também é a tag atlas.env.
ATLAS_ENV=dev

# [padrão] Projeto GCP com o BigQuery
GCP_PROJECT=ppgcc-dengue-project

# [padrão] Bucket GCS dos artefatos (MLflow, cache do Cosmos, documentação do dbt, figuras)
ATLAS_BUCKET=ppgcc-bucket

# [padrão] Site e API: tempo máximo de cada chamada ao backend (ms) e cache das páginas HTML (s)
BACKEND_TIMEOUT_MS=8000
PAGE_CACHE_SECONDS=300

# ======================================================================================
# 2. Só desenvolvimento local (platform/compose.dev.yml, npm run dev)
# ======================================================================================

# [segredo] Senha do superusuário do Postgres local (em dev, também a dos usuários mlflow e airflow)
POSTGRES_PASSWORD=troque-esta-senha

# [segredo] Senha do usuário admin do Airflow (dev e stack)
AIRFLOW_ADMIN_PASSWORD=troque-esta-senha

# [padrão] Token do JupyterLab (./platform/dev.ps1 notebook)
JUPYTER_TOKEN=atlas

# [padrão] Vazio = artefatos do MLflow num volume Docker local. Com o bucket (ex.: ppgcc-bucket) vão
# para gs://<bucket>/mlflow/dev e exigem platform/secrets/mlflow-sa.json
MLFLOW_ARTIFACTS_BUCKET=

# [padrão] Certificado raiz da inspeção TLS da rede corporativa (relativo a platform/ ou absoluto).
# Vazio fora da rede da empresa.
EXTRA_CA_PATH=

# [padrão] Portas no host (só 127.0.0.1)
MLFLOW_PORT=5000
AIRFLOW_PORT=8080
BACKEND_PORT=8000
FRONTEND_PORT=4321
JUPYTER_PORT=8888

# [padrão] Site (npm run dev em frontend/): URL interna do backend e URL pública do site
API_INTERNAL_URL=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:4321

# ======================================================================================
# 3. Stack de hml e prod (docker-compose.yml da raiz, no Portainer)
# ======================================================================================

# [obrigatória] Imagens: prefixo do DockerHub e tag. hml usa a tag móvel "hml"; prod usa a versão
# imutável X.Y. Nunca latest.
IMAGE_REPO_PREFIX=anselmomendes/atlas-epidemiologia
IMAGE_TAG=hml

# [padrão] Nó em que o Airflow, o Postgres e os volumes rodam (um nó): manager ou worker
PLACEMENT_ROLE=manager

# [padrão] Processos do servidor MLflow (cada um ocupa ~1 GB na VPS)
MLFLOW_WORKERS=1

# [padrão] Threads por tarefa de treino dos modelos (VPS de 4 CPUs; o pool atlas_treino deixa um
# treino pesado por vez)
ATLAS_THREADS=2

# [padrão] Tarefas simultâneas no Airflow inteiro (todas rodam dentro do scheduler, que tem 3 CPUs e
# 3,5 GB no stack). Acima disso o scheduler perde o heartbeat e o Swarm o reinicia no meio do dbt.
AIRFLOW_PARALLELISM=6

# [obrigatória] Hosts públicos (Traefik) e URL do site. Sugestão para hml: hml.dengue..., api-hml.dengue...
FRONTEND_HOST=hml.dengue.example.com
FRONTEND_PUBLIC_URL=https://hml.dengue.example.com
API_HOST=api-hml.dengue.example.com
AIRFLOW_HOST=airflow-hml.dengue.example.com
MLFLOW_HOST=mlflow-hml.dengue.example.com

# [obrigatória] Origens (CIDR, separadas por vírgula) que acessam Airflow e MLflow pelo Traefik
ADMIN_ALLOWED_CIDRS=203.0.113.10/32

# [padrão] Backend: trava de custo por consulta (bytes faturados) e prefixo das figuras no bucket
MAX_BYTES_BILLED=1073741824
FORECAST_PREFIX=forecast/

# --- Segredos do stack: valores reais só no Portainer -------------------------------------------

# [segredo] Senhas dos usuários de serviço do Postgres (distintas entre si e da do superusuário)
MLFLOW_DB_PASSWORD=troque-esta-senha
AIRFLOW_DB_PASSWORD=troque-esta-senha

# [segredo] Airflow: JWT secret (qualquer texto longo e aleatório) e Fernet key
# (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW_JWT_SECRET=troque-esta-senha
AIRFLOW_FERNET_KEY=troque-esta-senha
# [padrão] E-mail do admin do Airflow
AIRFLOW_ADMIN_EMAIL=admin@example.com

# [obrigatória] MLflow: admin da autenticação (também usado pelas tarefas de treino do Airflow) e
# chave fixa do CSRF (a mesma entre reinícios)
MLFLOW_ADMIN_USERNAME=admin
MLFLOW_ADMIN_PASSWORD=troque-esta-senha
MLFLOW_FLASK_SECRET_KEY=troque-esta-senha

# Docker secrets (criados antes no Portainer, não são variáveis): atlas_<ambiente>_training_sa,
# atlas_<ambiente>_mlflow_sa e atlas_<ambiente>_backend_sa, com o JSON de cada service account.
