# Copie para platform/.env (ignorado pelo git) e preencha.
# Usado pelo compose de dev (platform/compose.dev.yml) via platform/dev.ps1.

# Projeto GCP com o BigQuery (leitura de features)
GCP_PROJECT=ppgcc-dengue-project

# Bucket GCS dos artefatos do MLflow (prefixo mlflow/dev/). Opcional:
# vazio = artefatos num volume Docker local. Para usar o GCS: MLFLOW_ARTIFACTS_BUCKET=ppgcc-bucket
# e coloque a chave da SA do MLflow em platform/secrets/mlflow-sa.json.
MLFLOW_ARTIFACTS_BUCKET=

# Senha do superusuário do Postgres local (em dev, também a dos usuários mlflow e airflow)
POSTGRES_PASSWORD=troque-esta-senha

# Senha do usuário admin do Airflow local
AIRFLOW_ADMIN_PASSWORD=troque-esta-senha

# Token do JupyterLab (./platform/dev.ps1 notebook)
JUPYTER_TOKEN=atlas

# Opcional: certificado raiz da inspeção TLS da rede corporativa (Cloudflare Gateway),
# caminho relativo a platform/ ou absoluto. Deixe vazio fora da rede da empresa.
EXTRA_CA_PATH=

# Chaves de service account NÃO vão aqui: coloque os arquivos em platform/secrets/ com os nomes
#   mlflow-sa.json    (SA do MLflow: só o bucket)
#   training-sa.json  (SA de treino: leitura no BigQuery)
