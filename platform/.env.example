# Copie para platform/.env (ignorado pelo git) e preencha.
# Usado pelo compose de dev (platform/compose.dev.yml).

# Projeto GCP com o BigQuery e o bucket de artefatos
GCP_PROJECT=ppgcc-dengue-project

# Bucket GCS onde o MLflow grava artefatos (o servidor usa o prefixo mlflow/dev/)
MLFLOW_ARTIFACTS_BUCKET=ppgcc-dengue-ml-artifacts

# Chave JSON da service account do MLflow (acesso só ao bucket). Caminho no seu computador.
MLFLOW_SA_KEY_PATH=./secrets/mlflow-sa.json

# Chave JSON da service account de treino (leitura no BigQuery). Caminho no seu computador.
TRAINING_SA_KEY_PATH=./secrets/training-sa.json

# Senha do superusuário do Postgres local (os usuários de cada serviço derivam dela no init)
POSTGRES_PASSWORD=troque-esta-senha

# Senha do usuário admin do Airflow local
AIRFLOW_ADMIN_PASSWORD=troque-esta-senha

# Opcional: certificado raiz da inspeção TLS da rede corporativa (Cloudflare Gateway).
# Deixe vazio fora da rede da empresa.
EXTRA_CA_PATH=
