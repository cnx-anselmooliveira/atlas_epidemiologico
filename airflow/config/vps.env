# Airflow — VPS (hml e prod). Valores não secretos; segredos ficam nas variáveis da stack no Portainer.
# ATLAS_ENV (hml|prod), banco, chaves e credenciais do MLflow são definidos por stack.
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
AIRFLOW__API__EXPOSE_CONFIG=False
AIRFLOW__WEBSERVER__WARN_DEPLOYMENT_EXPOSURE=False
