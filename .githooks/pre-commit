#!/usr/bin/env bash
# Antes do commit: barra credenciais e notebooks com saídas de células (o repositório é público).
# Ative uma vez por clone:
#   git config core.hooksPath .githooks
set -euo pipefail

raiz="$(git rev-parse --show-toplevel)"
"$raiz/platform/ci/check-secrets.sh" --staged

notebooks="$(git diff --cached --name-only --diff-filter=ACM -- '*.ipynb' | sed "s|^|$raiz/|")"
if [ -n "$notebooks" ]; then
  py=""
  for candidato in python3 python py; do
    # no Windows, python3 pode ser o atalho da Microsoft Store (existe e não executa): testa de verdade
    if "$candidato" -c "pass" >/dev/null 2>&1; then
      py="$candidato"
      break
    fi
  done
  if [ -z "$py" ]; then
    echo "pre-commit: Python não encontrado, não foi possível conferir as saídas dos notebooks" >&2
    exit 1
  fi
  # shellcheck disable=SC2086  # a lista é de caminhos sem espaço, um por linha
  "$py" "$raiz/ml/notebooks/_ferramentas/verificar_sem_saidas.py" $notebooks
fi
