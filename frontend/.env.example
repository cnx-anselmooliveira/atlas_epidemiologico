# Copie para frontend/.env (ignorado pelo git). Lidas pelo servidor em runtime.

# URL interna do backend (API gold). Local: a API da stack platform/ (./platform/dev.ps1 up)
API_INTERNAL_URL=http://localhost:8000
# Tempo máximo de cada chamada ao backend (ms); passou disso, a página responde 503
BACKEND_TIMEOUT_MS=8000
# Cache-Control das páginas HTML (s)
PAGE_CACHE_SECONDS=300
# URL pública do site (canonical e Open Graph)
PUBLIC_SITE_URL=http://localhost:4321
